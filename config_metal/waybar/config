{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-bottom": 0,
    "spacing": 0,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/sysstats", "tray", "privacy", "battery"],
    "clock": {
        "interval": 30,
        "format": "[{:%m/%d %I:%M}]"
    },
    "custom/sysstats": {
        "exec": "$HOME/.config/waybar/sysstats.sh",
        "interval": 2,
        "tooltip": false
    },
    "battery": {
        "interval": 5,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {icon} {capacity}%",
        "format-plugged": "⚡ {icon} {capacity}%",
        "format-full": "⚡ {icon} {capacity}%",
        "format-not-charging": "{icon} {capacity}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip-format": "{capacity}%  {time}"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "privacy": {
        "icon-size": 18,
        "icon-spacing": 4,
        "modules": [
            {
                "type": "audio-in",
                "tooltip": true
            }
        ]
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "brave",
            "2": "term1",
            "3": "term2",
            "4": "term3",
            "5": "virtmgr",
            "default": "{name}"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    }
}
