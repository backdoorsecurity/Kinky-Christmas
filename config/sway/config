############################################ [SWAY CONFIG] ###########################################

############################################# [VARIABLES] ##########################################

# Logo key. Use Mod1 for Alt.
set $mod Mod1

# Your preferred terminal emulator
set $term foot
# numbered so waybar sorts L→R; labels live in waybar format-icons
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5

#fix virt-manager mouse flaw
#exec_always export WLR_NO_HARDWARE_CURSORS=1

###############################################################################################


######################################## [KEYBINDINGS] ########################################
	
#	bindsym $mod+a workspace [1]
#	bindsym $mod+s workspace [2]
#	bindsym $mod+d workspace [3]
#	bindsym $mod+f workspace [4]
#	bindsym $mod+g workspace [5]

#	Workspace switching (static 1–5; labels in waybar)
	bindsym $mod+a workspace $ws1
	bindsym $mod+s workspace $ws2
	bindsym $mod+d workspace $ws3
	bindsym $mod+f workspace $ws4
	bindsym $mod+g workspace $ws5

#	Move focused container to workspace (add these for completeness)
	bindsym $mod+Shift+a move container to workspace $ws1
	bindsym $mod+Shift+s move container to workspace $ws2
	bindsym $mod+Shift+d move container to workspace $ws3
	bindsym $mod+Shift+f move container to workspace $ws4
	bindsym $mod+Shift+g move container to workspace $ws5
	
	bindsym $mod+j focus left
	bindsym $mod+Down focus down
	bindsym $mod+Up focus up
	bindsym $mod+k focus right
	
	bindsym $mod+Shift+r reload
	
	bindsym $mod+x kill
        bindsym $mod+q workspace $ws1, exec --no-startup-id QT_QPA_PLATFORMTHEME=qt6ct brave-origin-nightly --qt-version=6 --silent-debugger-extension-api
        bindsym $mod+shift+q exec --no-startup-id chromium
        bindsym $mod+w exec --no-startup-id foot
        bindsym $mod+e exec --no-startup-id foot
        bindsym $mod+r exec --no-startup-id foot
        bindsym $mod+t workspace $ws5, exec --no-startup-id virt-manager
        bindsym $mod+Print exec $HOME/.config/sway/keybindings/screenrecord.kb
        bindsym $mod+m exec --no-startup-id $HOME/.config/sway/scripts/dictate-toggle
	bindsym $mod+i fullscreen
	# Display presets: low-res scale1 (game/UI) vs native HiDPI
	bindsym $mod+minus output eDP-1 mode --custom 1280x800@60Hz scale 1
	bindsym $mod+equal output eDP-1 resolution 2560x1600@60Hz scale 1.8
	bindsym $mod+Escape exec $HOME/.config/sway/keybindings/poweroff.kb

#	bindsym $mod+0 layout stacking
#	bindsym $mod+9 layout tabbed
#	bindsym $mod+8 layout toggle split
#	mode "resize" {
#	up/down height left/right width
#	bindsym Left resize shrink width 10px
#	You can "split" the current object of your focus with
#	$mod+b or $mod+v, for horizontal and vertical splits
#	respectively.
#	bindsym $mod+0 splith
#	bindsym $mod+9 splitv
#	Toggle the current focus between tiling and floating mode
#	bindsym $mod+8 floating toggle

	bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
	bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
	bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
	bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
	bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
	bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
	bindsym Print exec grim

############################################################################################################

######################################## [INPUTS/OUTPUTS] ##################################################

#	[DISPLAY]
# Panel EDID only advertises 2560x1600@60/165. Lower modes need --custom
# (panel scaler); Plasma synthesizes these, Sway does not unless asked.
	output eDP-1 {
	mode --custom 1280x800@60Hz scale 1
	}
# HiDPI desktop (native):  output eDP-1 resolution 2560x1600@60Hz scale 1.8
# Other custom 16:10:      1600x1000@60Hz / 1920x1200@60Hz

#	[TOUCHPAD]
	input * { 
	dwt enabled
	tap enable
	accel_profile adaptive
        pointer_accel 1 drag enabled
        #middle_emulation enabled
}
#	[KEYBOARD]
	input * {
#	input 1165:51605:ITE_Tech._Inc._ITE_Device(8295)_Keyboard {
#        input 1:1:AT_Translated_Set_2_keyboard {
	repeat_delay 250
	repeat_rate 60
}

#########################################################################################################

########################################## [STYLING] ####################################################

# [Status Bar] swaybar has no persistent empty workspaces; waybar does.
# Bar colors live in ~/.config/waybar/style.css (not sway colors {}).
bar {
    position top
    swaybar_command waybar
}

# pin apps onto the static workspaces (terminals stay unassigned)
assign [app_id="brave-origin-nightly"] $ws1
assign [app_id="brave-browser"] $ws1
assign [class="Brave-browser"] $ws1
assign [app_id="org.virt-manager.virt-manager"] $ws5
assign [class="Virt-manager"] $ws5
assign [class="virt-manager"] $ws5

# [WINDOW MANAGEMENT]
#colors text backup: #73d41e
#                       border| background|text|   indicator|child_border
client.focused          #3052ff #090404    #99e01c #000010   #000000
client.focused_inactive #3052ff #090404    #99e01c #000010   #000000
client.unfocused        #3052ff #090404    #99e01c #000010   #000000
client.urgent           #3052ff #090404    #99e01c #000010   #000000
client.placeholder      #3052ff #090404    #99e01c #000010   #000000

# [WINDOW SIZING]
#
titlebar_border_thickness 0
default_border pixel 0
#default_floating_border pixel 8 8
#titlebar_padding 3 3
#gaps inner 2
#title_align center

#set cursor style
seat * xcursor_theme Oxygen_Black/ 50
#exec_always brightnessctl set 70%
#exec_always pgrep -x wlsunset || wlsunset -t 3200
# NetworkManager tray icon (picked up by waybar tray module)
exec_always pgrep -x nm-applet >/dev/null || nm-applet --indicator
# pcmanfm-qt draws the desktop folders. Wallpaper is not set here.
exec_always pgrep -x pcmanfm-qt >/dev/null || QT_QPA_PLATFORM=wayland QT_QPA_PLATFORMTHEME=qt6ct pcmanfm-qt --desktop --profile=sway
font monospace 14
#set $WLR_RENDERER gles2
include /etc/sway/config-vars.d/*
include /etc/sway/config.d/*
