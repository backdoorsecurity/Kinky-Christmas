/* Local Swaytastic/qt6ct chrome: accent outline boxes, extra item padding. */

QMenu {
    background: #130303;
    color: #307005;
    border: 1px solid #400505;
    padding: 6px;
    margin: 0px;
}

QMenu::item {
    background: transparent;
    color: #307005;
    padding: 6px 28px 6px 12px;
    margin: 1px 0px;
}

QMenu::item:selected {
    background: #400505;
    color: #307005;
}

QMenu::item:disabled {
    color: #601510;
}

QMenu::separator {
    height: 2px;
    background: #400505;
    margin: 6px 8px;
}

QMenu::right-arrow {
    image: url(/usr/share/qt6ct/qss/right.png);
    width: 10px;
    height: 10px;
}

QFrame, QGroupBox, QTabWidget::pane {
    border: 1px solid #400505;
}

QGroupBox {
    margin-top: 10px;
    padding: 10px 8px 8px 8px;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox, QAbstractSpinBox {
    background: #030903;
    color: #601510;
    border: 1px solid #400505;
    padding: 4px 8px;
    selection-background-color: #400505;
    selection-color: #307005;
}

QComboBox::drop-down {
    border-left: 1px solid #400505;
    width: 22px;
    background: #400505;
}

QComboBox::down-arrow {
    image: url(/usr/share/qt6ct/qss/down.png);
    width: 10px;
    height: 10px;
}

/* Desktop is a fullscreen layer-shell surface (exclusive zone -1), so a
   QFrame border here becomes a screen outline and also wraps waybar.
   Namespaced class is PCManFM::DesktopWindow → PCManFM--DesktopWindow. */
PCManFM--DesktopWindow,
PCManFM--DesktopWindow QFrame,
PCManFM--DesktopWindow QListView,
PCManFM--DesktopWindow QAbstractScrollArea,
PCManFM--DesktopWindow QAbstractScrollArea::viewport,
DesktopWindow,
DesktopWindow QFrame,
DesktopWindow QListView,
DesktopWindow QAbstractScrollArea,
DesktopWindow QAbstractScrollArea::viewport {
    border: 0px solid transparent;
    outline: 0px;
    qproperty-frameShape: 0;
    qproperty-lineWidth: 0;
    qproperty-midLineWidth: 0;
}

/* Folder windows only. A global QListView fill pins pcmanfm-qt's desktop
   BgColor/FgColor (Preferences → Desktop) back to black/green. */
QMainWindow QTreeView, QDialog QTreeView,
QMainWindow QListView, QDialog QListView,
QMainWindow QTableView, QDialog QTableView,
QMainWindow QColumnView, QDialog QColumnView {
    background: #130303;
    color: #307005;
    border: 1px solid #400505;
    padding: 4px;
    outline: 0;
}

QMainWindow QTreeView::item, QDialog QTreeView::item,
QMainWindow QListView::item, QDialog QListView::item,
QMainWindow QTableView::item, QDialog QTableView::item {
    padding: 5px 8px;
    min-height: 22px;
}

QMainWindow QTreeView::item:selected, QDialog QTreeView::item:selected,
QMainWindow QListView::item:selected, QDialog QListView::item:selected,
QMainWindow QTableView::item:selected, QDialog QTableView::item:selected {
    background: #400505;
    color: #307005;
}

QHeaderView::section {
    background: #130303;
    color: #307005;
    border: 1px solid #400505;
    padding: 6px 10px;
}

QSplitter::handle {
    background: #400505;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QScrollBar:vertical {
    background: #130303;
    width: 12px;
    border: 1px solid #400505;
    margin: 0;
}

QScrollBar:horizontal {
    background: #130303;
    height: 12px;
    border: 1px solid #400505;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #400505;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QPushButton {
    background: #130303;
    color: #307005;
    border: 1px solid #400505;
    padding: 5px 14px;
}

QPushButton:hover, QPushButton:focus {
    background: #030903;
}

QToolTip {
    background: #130303;
    color: #307005;
    border: 1px solid #400505;
    padding: 4px 8px;
}

QStatusBar {
    border-top: 1px solid #400505;
}

/* Fusion derives checkbox/radio outlines from Window.darker(). Window is
   near-black, so the indicators vanish without an explicit border. */
QCheckBox, QRadioButton {
    color: #307005;
    spacing: 8px;
}

QCheckBox::indicator, QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #400505;
    background: #130303;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background: #307005;
}

QCheckBox::indicator:disabled, QGroupBox::indicator:disabled {
    border-color: #400505;
    background: #130303;
}

QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled {
    background: #307005;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #400505;
    border-radius: 8px;
    background: #130303;
}

QRadioButton::indicator:checked {
    background: #307005;
}

QRadioButton::indicator:disabled {
    border-color: #400505;
    background: #130303;
}

QRadioButton::indicator:checked:disabled {
    background: #307005;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #400505;
    background: #130303;
}

QMenu::indicator:checked {
    background: #307005;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 16px;
    background: #400505;
    border: none;
}

QAbstractSpinBox::up-arrow {
    image: url(/usr/share/qt6ct/qss/up.png);
    width: 8px;
    height: 8px;
}

QAbstractSpinBox::down-arrow {
    image: url(/usr/share/qt6ct/qss/down.png);
    width: 8px;
    height: 8px;
}
